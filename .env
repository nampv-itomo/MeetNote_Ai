# =============================================================================
# MeetNote AI - Environment Configuration
# =============================================================================
# Các biến môi trường này được load bởi app.py và các module.
# Khi thay đổi đường dẫn, chỉ cần cập nhật file này.
# =============================================================================

# --- Model Paths ---
# Đường dẫn model Qwen3-ASR 1.7B (dành cho transcribe_qwen3.py)
QWEN3_ASR_MODEL_17B=/run/media/viper/Data/models/qwen3-asr-0.6b/qwen3-asr-1.7b-q4_k.gguf

# Đường dẫn model Qwen3-ASR 0.6B (dành cho transcribe_qwen3_fast.py)
QWEN3_ASR_MODEL_06B=/run/media/viper/Data/models/qwen3-asr-0.6b/qwen3-asr-0.6b-q4_k.gguf

# Đường dẫn wrapper CrispASR
CRISP_ASR_BIN=/home/viper/bin/qwen3-asr

# --- LLM / Summarize ---
# URL llama.cpp server
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_MODEL=llama-model

# --- TTS ---
TTS_MODEL_PATH=/run/media/viper/Data/models

# --- Paths ---
UPLOAD_FOLDER=/home/viper/Work/ME/MiAI_MeetNote_Ai/uploads
TEMP_SEGMENTS=/home/viper/Work/ME/MiAI_MeetNote_Ai/temp_segments
RESULTS_FOLDER=/home/viper/Work/ME/MiAI_MeetNote_Ai/results
TTS_OUTPUT=/home/viper/Work/ME/MiAI_MeetNote_Ai/tts_output
